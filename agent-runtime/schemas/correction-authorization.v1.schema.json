{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CorrectionAuthorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authorization_id",
    "work_id",
    "source_revision",
    "delivery_cycle_id",
    "origin",
    "source_receipt_id",
    "feedback_analysis_id",
    "decision",
    "scope",
    "affected_ac_ids",
    "affected_files",
    "platform_knowledge_context_id",
    "platform_knowledge_digest",
    "disposition",
    "actor",
    "pointer",
    "created_at"
  ],
  "properties": {
    "schema": { "const": "CorrectionAuthorization/v1" },
    "authorization_id": { "type": "string", "minLength": 1 },
    "work_id": { "type": "string", "minLength": 1 },
    "source_revision": { "type": "string", "minLength": 1 },
    "delivery_cycle_id": { "type": "string", "minLength": 1 },
    "origin": { "enum": ["delivery", "testing"] },
    "source_receipt_id": { "type": "string", "minLength": 1 },
    "feedback_analysis_id": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["defect", "rework"] },
    "scope": { "enum": ["local", "cross_scope", "persistent"] },
    "affected_ac_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "affected_files": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "platform_knowledge_context_id": { "type": "string", "minLength": 1 },
    "platform_knowledge_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "disposition": { "enum": ["feedback_bounded_correction", "triage_required", "architect_required", "clarification_required"] },
    "actor": { "type": "string", "minLength": 1 },
    "pointer": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
