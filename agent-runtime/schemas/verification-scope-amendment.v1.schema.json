{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerificationScopeAmendment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "amendment_id", "work_id", "source_revision", "prior_scope_id", "scope_id",
    "ac_ids", "added_files", "scope_contract_digest", "platform_knowledge_context_id",
    "platform_knowledge_digest", "evidence", "reason", "actor", "pointer",
    "from_revision", "to_revision", "timestamp"
  ],
  "properties": {
    "schema": { "const": "VerificationScopeAmendment/v1" },
    "amendment_id": { "type": "string", "minLength": 1 },
    "work_id": { "type": "string", "minLength": 1 },
    "source_revision": { "type": "string", "minLength": 1 },
    "prior_scope_id": { "type": "string", "minLength": 1 },
    "scope_id": { "type": "string", "minLength": 1 },
    "ac_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "added_files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "scope_contract_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "platform_knowledge_context_id": { "type": "string", "minLength": 1 },
    "platform_knowledge_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "command", "path", "expected", "actual", "pointer"],
      "properties": {
        "status": { "const": "failed" },
        "command": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "expected": { "type": "string", "minLength": 1 },
        "actual": { "type": "string", "minLength": 1 },
        "pointer": { "type": "string", "minLength": 1 }
      }
    },
    "reason": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "pointer": { "type": "string", "minLength": 1 },
    "from_revision": { "type": "integer", "minimum": 1 },
    "to_revision": { "type": "integer", "minimum": 1 },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
