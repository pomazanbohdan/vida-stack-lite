{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CrossScopeCorrectionAuthorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "authorization_id", "work_id", "source_revision", "delivery_cycle_id",
    "origin", "source_receipt_id", "feedback_analysis_id", "decision", "scope",
    "affected_ac_ids", "affected_files", "prior_scope_id", "scope_id",
    "scope_contract_digest", "platform_knowledge_context_id", "platform_knowledge_digest",
    "disposition", "reason", "actor", "pointer", "from_revision", "to_revision", "created_at"
  ],
  "properties": {
    "schema": { "const": "CrossScopeCorrectionAuthorization/v1" },
    "authorization_id": { "type": "string", "minLength": 1 },
    "work_id": { "type": "string", "minLength": 1 },
    "source_revision": { "type": "string", "minLength": 1 },
    "delivery_cycle_id": { "type": "string", "minLength": 1 },
    "origin": { "enum": ["delivery", "testing"] },
    "source_receipt_id": { "type": "string", "minLength": 1 },
    "feedback_analysis_id": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["defect", "rework"] },
    "scope": { "const": "cross_scope" },
    "affected_ac_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "affected_files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "prior_scope_id": { "type": "string", "minLength": 1 },
    "scope_id": { "type": "string", "minLength": 1 },
    "scope_contract_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "platform_knowledge_context_id": { "type": "string", "minLength": 1 },
    "platform_knowledge_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "disposition": { "const": "scope_expansion_correction" },
    "reason": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "pointer": { "type": "string", "minLength": 1 },
    "from_revision": { "type": "integer", "minimum": 1 },
    "to_revision": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
