{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewBatch v1",
  "type": "object",
  "required": ["schema", "status", "batch_id", "operation_id", "work_id", "packet_id", "fingerprint", "review_mode", "requested", "started", "completed", "cancelled", "entries", "preflight_id", "created_at", "next_action"],
  "properties": {
    "schema": {"const": "ReviewBatch/v1"},
    "status": {"enum": ["running", "complete", "blocked"]},
    "batch_id": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "work_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "review_mode": {"enum": ["exact-three", "single-composite"]},
    "change_impact_assessment_id": {"type": ["string", "null"], "minLength": 1},
    "change_impact_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "change_impact_status": {"enum": ["pass", "warning", "full_profile_required", "blocked", null]},
    "change_impact_test_profile": {"enum": ["focused", "expanded", "full", null]},
    "requested": {"enum": [1, 3]},
    "started": {"type": "integer", "minimum": 0},
    "completed": {"type": "integer", "minimum": 0},
    "cancelled": {"type": "integer", "minimum": 0},
    "entries": {"type": "array", "items": {"type": "object", "required": ["handle_id", "task_id", "dispatch_id", "reviewer_id", "lens", "host_handle"], "properties": {"handle_id": {"type": "string", "minLength": 1}, "task_id": {"type": "string", "minLength": 1}, "dispatch_id": {"type": "string", "minLength": 1}, "reviewer_id": {"type": "string", "minLength": 1}, "lens": {"type": "string", "minLength": 1}, "host_handle": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "preflight_id": {"type": "string", "minLength": 1},
    "assurance_context_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "minLength": 1},
    "next_action": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
