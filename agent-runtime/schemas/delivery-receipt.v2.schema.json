{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"DeliveryReceipt v2","type":"object","required":["schema","work_id","source_revision","sealed_revision","implementation_fingerprint","acceptance_manifest_id","acceptance_manifest_version","delivery_cycle_id","actor","timestamp","source","decision","sanitized_pointers","deployment_manifest"],"properties":{"schema":{"const":"DeliveryReceipt/v2"},"work_id":{"type":"string","minLength":1},"source_revision":{"type":"string","minLength":1},"sealed_revision":{"type":"integer","minimum":1},"implementation_fingerprint":{"type":"string","pattern":"^[a-f0-9]{64}$"},"acceptance_manifest_id":{"type":"string","minLength":1},"acceptance_manifest_version":{"type":"integer","minimum":1},"delivery_cycle_id":{"type":"string","minLength":1},"actor":{"type":"string","minLength":1},"timestamp":{"type":"string","format":"date-time"},"source":{"type":"string","minLength":1},"decision":{"enum":["approved","feedback","rejected"]},"sanitized_pointers":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"deployment_manifest":{"$ref":"deployment-manifest.v1.schema.json"}},"additionalProperties":false}
