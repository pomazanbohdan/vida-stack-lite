{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewSetTriage v1",
  "type": "object",
  "required": ["schema", "triage_id", "work_id", "source_revision", "packet_id", "generation", "receipt_ids", "items", "has_blocking_current", "status", "owner", "created_at"],
  "properties": {
    "schema": {"const": "ReviewSetTriage/v1"}, "triage_id": {"type": "string", "minLength": 1}, "work_id": {"type": "string", "minLength": 1}, "source_revision": {"type": "string", "minLength": 1}, "packet_id": {"type": "string", "minLength": 1}, "generation": {"type": "integer", "minimum": 1},
    "receipt_ids": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "items": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["triage_id", "receipt_id", "finding_ids", "disposition", "ac_refs", "evidence_pointers"], "properties": {"triage_id": {"type": "string", "minLength": 1}, "receipt_id": {"type": "string", "minLength": 1}, "finding_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "disposition": {"enum": ["blocking_current_ac", "critical_regression", "new_requirement", "follow_up", "advisory", "invalid_or_unproven"]}, "ac_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "evidence_pointers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false}},
    "has_blocking_current": {"type": "boolean"}, "status": {"enum": ["accepted", "requires_correction", "requires_scope_decision"]}, "owner": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
