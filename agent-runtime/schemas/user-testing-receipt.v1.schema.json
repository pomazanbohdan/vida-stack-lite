{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UserTestingReceipt v1",
  "type": "object",
  "required": ["schema", "work_id", "source_revision", "sealed_revision", "implementation_fingerprint", "acceptance_manifest_id", "acceptance_manifest_version", "delivery_cycle_id", "decision", "actor", "source", "timestamp", "sanitized_pointers"],
  "properties": {
    "schema": { "const": "UserTestingReceipt/v1" },
    "work_id": { "type": "string", "minLength": 1 },
    "source_revision": { "type": "string", "minLength": 1 },
    "sealed_revision": { "type": "integer", "minimum": 1 },
    "implementation_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "acceptance_manifest_id": { "type": "string", "minLength": 1 },
    "acceptance_manifest_version": { "type": "integer", "minimum": 1 },
    "delivery_cycle_id": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["started", "accepted", "feedback", "rejected"] },
    "actor": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "sanitized_pointers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
