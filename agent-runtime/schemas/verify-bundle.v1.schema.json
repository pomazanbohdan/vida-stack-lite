{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerifyBundle v1",
  "type": "object",
  "required": ["schema", "checks"],
  "properties": {
    "schema": {"const": "VerifyBundle/v1"},
    "artifact_dir": {"type": "string", "minLength": 1},
    "max_parallel": {"type": "integer", "minimum": 1, "maximum": 16},
    "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 3600000},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "command"], "properties": {"id": {"type": "string", "minLength": 1}, "command": {"type": "string", "minLength": 1}, "args": {"type": "array", "items": {"type": "string"}}, "cwd": {"type": "string", "minLength": 1}, "serial": {"type": "boolean"}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
