{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewPreflight v1",
  "type": "object",
  "required": ["schema", "status", "operation_id", "work_id", "source_revision", "sealed_revision", "implementation_fingerprint", "packet_id", "packet_version", "wave", "generation", "review_mode", "requested_reviewers", "dirty_overlap", "source_hashes", "document_hashes", "profile", "lease", "capability_epoch", "active_dispatch", "previous_packet_id", "snapshot", "created_at", "next_action"],
  "properties": {
    "schema": {"const": "ReviewPreflight/v1"},
    "status": {"const": "pass"},
    "operation_id": {"type": "string", "minLength": 1},
    "work_id": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "sealed_revision": {"type": "integer", "minimum": 1},
    "implementation_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "packet_id": {"type": "string", "minLength": 1},
    "packet_version": {"type": "integer", "minimum": 1},
    "wave": {"type": "integer", "minimum": 1},
    "generation": {"type": "integer", "minimum": 1},
    "review_mode": {"enum": ["exact-three", "single-composite"]},
    "requested_reviewers": {"enum": [1, 3]},
    "dirty_overlap": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
    "source_hashes": {"$ref": "#/$defs/hashList"},
    "document_hashes": {"$ref": "#/$defs/hashList"},
    "profile": {"type": "object", "required": ["model", "reasoning", "attestable"], "properties": {"model": {"type": "string", "minLength": 1}, "reasoning": {"type": "string", "minLength": 1}, "attestable": {"const": true}}, "additionalProperties": false},
    "lease": {"type": "object", "required": ["status", "expires_at"], "properties": {"status": {"const": "active"}, "expires_at": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "capability_epoch": {"type": "string", "minLength": 1},
    "active_dispatch": {"const": false},
    "previous_packet_id": {"type": ["string", "null"]},
    "change_impact_assessment_id": {"type": ["string", "null"], "minLength": 1},
    "change_impact_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "change_impact_status": {"enum": ["pass", "warning", "full_profile_required", "blocked", null]},
    "change_impact_test_profile": {"enum": ["focused", "expanded", "full", null]},
    "context_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "snapshot": {"type": "object", "required": ["source_revision", "sealed_revision", "implementation_fingerprint", "packet_id", "packet_version", "wave", "generation", "source_hashes", "document_hashes", "profile", "capability_epoch", "lease_expires_at"], "properties": {"source_revision": {"type": "string", "minLength": 1}, "sealed_revision": {"type": "integer", "minimum": 1}, "implementation_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "packet_id": {"type": "string", "minLength": 1}, "packet_version": {"type": "integer", "minimum": 1}, "wave": {"type": "integer", "minimum": 1}, "generation": {"type": "integer", "minimum": 1}, "source_hashes": {"$ref": "#/$defs/hashList"}, "document_hashes": {"$ref": "#/$defs/hashList"}, "profile": {"type": "object", "required": ["model", "reasoning"], "properties": {"model": {"type": "string", "minLength": 1}, "reasoning": {"type": "string", "minLength": 1}}, "additionalProperties": false}, "capability_epoch": {"type": "string", "minLength": 1}, "lease_expires_at": {"type": "string", "minLength": 1}, "context_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "change_impact_assessment_id": {"type": ["string", "null"], "minLength": 1}, "change_impact_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "change_impact_status": {"enum": ["pass", "warning", "full_profile_required", "blocked", null]}, "change_impact_test_profile": {"enum": ["focused", "expanded", "full", null]}}, "additionalProperties": false},
    "created_at": {"type": "string", "minLength": 1},
    "next_action": {"type": "string", "minLength": 1}
  },
  "$defs": {"hashList": {"type": "array", "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}}},
  "additionalProperties": false
}
