{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architect diagnostic dispatch v1",
  "type": "object",
  "required": ["schema", "work_id", "source_revision", "sealed_revision", "implementation_fingerprint", "acceptance_manifest_id", "acceptance_manifest_version", "dispatch_id", "task_id", "handle_id", "architect_id", "requested_model", "requested_reasoning_effort", "history_isolation", "requirement_pointers", "external_observation_pointers", "forbidden_context_asserted", "reserved_at"],
  "properties": {
    "schema": {"const": "ArchitectDiagnosticDispatch/v1"},
    "work_id": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "sealed_revision": {"type": "integer", "minimum": 1},
    "implementation_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "acceptance_manifest_id": {"type": "string", "minLength": 1},
    "acceptance_manifest_version": {"type": "integer", "minimum": 1},
    "dispatch_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "handle_id": {"type": "string", "minLength": 1},
    "architect_id": {"type": "string", "minLength": 1},
    "requested_model": {"const": "gpt-5.6-sol"},
    "requested_reasoning_effort": {"enum": ["high", "max", "xhigh"]},
    "history_isolation": {"const": true},
    "requirement_pointers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(BR|SR|AC):\\S"}},
    "external_observation_pointers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(observation|runtime):\\S"}},
    "forbidden_context_asserted": {"const": true},
    "reserved_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
