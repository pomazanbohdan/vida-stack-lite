{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillChangeProposal v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "proposal_id", "skill_id", "skill_path", "source_url", "source_hash", "rule", "evidence_pointers", "eval_manifest", "status", "created_at", "next_action"],
  "properties": {"schema": {"const": "SkillChangeProposal/v1"}, "proposal_id": {"type": "string", "minLength": 1}, "skill_id": {"type": "string", "minLength": 1}, "skill_path": {"type": "string", "minLength": 1}, "source_url": {"type": "string", "format": "uri"}, "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "rule": {"type": "string", "minLength": 1}, "evidence_pointers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "eval_manifest": {"type": "string", "minLength": 1}, "status": {"enum": ["proposed", "applied", "rejected"]}, "created_at": {"type": "string", "format": "date-time"}, "next_action": {"type": "string", "minLength": 1}}
}
