{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChangeImpactAssessment v1",
  "type": "object",
  "required": [
    "schema", "assessment_id", "work_id", "cycle_id", "source_revision", "scope_id",
    "phase", "snapshot_id", "implementation_fingerprint", "predicted_paths",
    "direct_impacts", "transitive_impacts", "contract_impacts", "behavioral_impacts",
    "security_impacts", "verified_paths", "unverified_edges", "unknown_edges",
    "unexpected_paths", "risk_flags", "predicted_test_profile", "status",
    "evidence_pointers", "assessed_by", "created_at", "digest"
  ],
  "properties": {
    "schema": {"const": "ChangeImpactAssessment/v1"},
    "assessment_id": {"type": "string", "minLength": 1},
    "work_id": {"type": "string", "minLength": 1},
    "cycle_id": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "phase": {"enum": ["pre", "post"]},
    "snapshot_id": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "implementation_fingerprint": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "predicted_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "direct_impacts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "transitive_impacts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "contract_impacts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "behavioral_impacts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "security_impacts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "verified_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "unverified_edges": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "unknown_edges": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "unexpected_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "risk_flags": {"type": "array", "uniqueItems": true, "items": {"enum": ["public_contract", "shared_boundary", "security", "data_loss", "migration", "destructive", "dirty_overlap", "unknown_dependency"]}},
    "predicted_test_profile": {"enum": ["focused", "expanded", "full"]},
    "status": {"enum": ["pass", "warning", "full_profile_required", "blocked"]},
    "fallback_reason": {"type": ["string", "null"]},
    "cache": {
      "type": ["object", "null"],
      "required": ["cache_key", "capability_epoch", "hit"],
      "properties": {
        "cache_key": {"type": "string", "minLength": 1},
        "capability_epoch": {"type": "string", "minLength": 1},
        "hit": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "evidence_pointers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "assessed_by": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
