{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DocumentationSkillValidation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "validation_id", "work_id", "cycle_id", "context_id", "source_revision", "status", "official_matches", "skill_matches", "findings", "evidence_pointers", "validated_by", "validated_at", "next_action"],
  "properties": {
    "schema": {"const": "DocumentationSkillValidation/v1"},
    "validation_id": {"type": "string", "minLength": 1}, "work_id": {"type": "string", "minLength": 1}, "cycle_id": {"type": "string", "minLength": 1}, "context_id": {"type": "string", "minLength": 1}, "source_revision": {"type": "string", "minLength": 1},
    "status": {"enum": ["pass", "warning", "changes_required"]},
    "official_matches": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source_url", "result", "evidence_pointer"], "properties": {"source_url": {"type": "string", "format": "uri"}, "result": {"enum": ["match", "warning", "mismatch"]}, "evidence_pointer": {"type": "string", "minLength": 1}, "summary": {"type": "string"}}}},
    "skill_matches": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["skill_id", "skill_sha256", "result", "evidence_pointer"], "properties": {"skill_id": {"type": "string", "minLength": 1}, "skill_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "result": {"enum": ["match", "warning", "missing", "obsolete", "mismatch", "not_applicable"]}, "evidence_pointer": {"type": "string", "minLength": 1}, "summary": {"type": "string"}}}},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "severity", "summary", "evidence_pointer"], "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"enum": ["missing_skill", "obsolete_skill", "unsupported_pattern", "documentation_conflict", "warning"]}, "severity": {"enum": ["low", "medium", "high", "critical"]}, "summary": {"type": "string", "minLength": 1}, "evidence_pointer": {"type": "string", "minLength": 1}}}},
    "evidence_pointers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "validated_by": {"type": "string", "minLength": 1}, "validated_at": {"type": "string", "format": "date-time"}, "next_action": {"type": "string", "minLength": 1}, "skill_update_proposal_id": {"type": ["string", "null"]}
  }
}
