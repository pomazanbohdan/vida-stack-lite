{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ReverseValidationReceipt v1","type":"object","required":["schema","receipt_id","reviewer_id","type","verdict","validator","timestamp","evidence","ac_refs","packet_id","packet_version","work_id","source_revision","sealed_revision","implementation_fingerprint","acceptance_manifest_id","acceptance_manifest_version"],"properties":{"schema":{"const":"ReverseValidationReceipt/v1"},"receipt_id":{"type":"string","minLength":1},"reviewer_id":{"type":"string","minLength":1},"type":{"enum":["trace_scope","technical_safety","evidence_truth"]},"verdict":{"const":"pass"},"validator":{"type":"string","minLength":1},"timestamp":{"type":"string","format":"date-time"},"evidence":{"type":"array","minItems":1},"ac_refs":{"type":"array","minItems":1},"packet_id":{"type":"string","minLength":1},"packet_version":{"type":"integer","minimum":1},"work_id":{"type":"string","minLength":1},"source_revision":{"type":"string","minLength":1},"sealed_revision":{"type":"integer","minimum":1},"implementation_fingerprint":{"type":"string","pattern":"^[a-f0-9]{64}$"},"acceptance_manifest_id":{"type":"string","minLength":1},"acceptance_manifest_version":{"type":"integer","minimum":1}},"additionalProperties":false}
