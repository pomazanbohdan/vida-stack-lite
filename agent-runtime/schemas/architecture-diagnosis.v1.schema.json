{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architecture diagnosis v1",
  "type": "object",
  "required": ["schema", "work_id", "source_revision", "sealed_revision", "implementation_fingerprint", "acceptance_manifest_id", "acceptance_manifest_version", "diagnosis_id", "dispatch_id", "task_id", "handle_id", "architect_id", "history_isolation", "blind_context_asserted", "profile_verified", "profile_verification", "outcome", "affected_ac_ids", "root_cause_hypothesis", "correction_direction", "dispatch_digest", "timestamp"],
  "properties": {
    "schema": {"const": "ArchitectureDiagnosis/v1"},
    "work_id": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "sealed_revision": {"type": "integer", "minimum": 1},
    "implementation_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "acceptance_manifest_id": {"type": "string", "minLength": 1},
    "acceptance_manifest_version": {"type": "integer", "minimum": 1},
    "diagnosis_id": {"type": "string", "minLength": 1},
    "dispatch_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "handle_id": {"type": "string", "minLength": 1},
    "architect_id": {"type": "string", "minLength": 1},
    "history_isolation": {"const": true},
    "blind_context_asserted": {"const": true},
    "profile_verified": {"const": true},
    "profile_verification": {
      "type": "object",
      "required": ["verified_model", "verified_reasoning_effort", "verification_source", "verification_pointer", "verified_at"],
      "properties": {
        "verified_model": {"const": "gpt-5.6-sol"},
        "verified_reasoning_effort": {"enum": ["high", "max", "xhigh"]},
        "verification_source": {"type": "string", "minLength": 1},
        "verification_pointer": {"type": "string", "minLength": 1},
        "verified_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "outcome": {"enum": ["defect_found", "no_architectural_defect_found"]},
    "affected_ac_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "root_cause_hypothesis": {"type": "string", "minLength": 1},
    "correction_direction": {"type": "string", "minLength": 1},
    "dispatch_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
