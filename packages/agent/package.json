    "format:check": "node bin/bun.mjs run format:check:pinned",
    "format:check:pinned": "oxfmt --config .oxfmtrc.json --check src tests tooling",
    "lint:oxlint": "node bin/bun.mjs run lint:oxlint:pinned",
    "lint:oxlint:pinned": "oxlint --type-aware --max-warnings 0 --config oxlint.config.json src tests tooling",
    "lint": "node bin/bun.mjs run lint:pinned",
    "lint:pinned": "bun run lint:oxlint:pinned",
    "verify": "node bin/bun.mjs run verify:pinned",
    "verify:pinned": "bun run verify:portable:pinned",
    "verify:portable": "node bin/bun.mjs run verify:portable:pinned",
    "verify:portable:pinned": "bun run test:toolchain:pinned && bun run preflight:pinned && bun run quality:static:pinned && bun run test:portable:pinned && bun run test:fuzz:pinned && bun run test:zombies:pinned && bun run format:check:pinned",
    "ci": "node bin/bun.mjs run ci:pinned",
    "ci:pinned": "bun run build:pinned && bun run prepack:pinned",
    "test:toolchain": "node bin/bun.mjs run test:toolchain:pinned",
    "test:toolchain:pinned": "bun test tests/bun-toolchain.test.mjs",
    "test:watch": "node bin/bun.mjs run test:watch:pinned",
    "test:watch:pinned": "bun test --watch ./tests/smoke.test.mjs",
    "test:smol": "node bin/bun.mjs run test:smol:pinned",
    "test:smol:pinned": "bun test --smol ./tests/smoke.test.mjs",
    "build:watch": "node bin/bun.mjs run build:watch:pinned",
    "build:watch:pinned": "tsc --project tsconfig.json --watch --preserveWatchOutput",
    "smoke": "node bin/bun.mjs run smoke:pinned",
    "smoke:pinned": "bun test tests/runtime-config-yaml.test.mjs tests/smoke.test.mjs tests/property.test.mjs tests/research-source-catalog.test.mjs",
    "format:list": "node bin/bun.mjs run format:list:pinned",
    "format:list:pinned": "oxfmt --config .oxfmtrc.json --list-different src tests tooling",
    "toolchain:sync": "node bin/bun.mjs --sync-pin",
    "test:host-state": "node bin/bun.mjs run test:host-state:pinned",
    "test:host-state:pinned": "bun test tests/bun/host-state.test.mjs tests/bun/lifecycle-state.test.mjs tests/bun/task-source-coordination.test.mjs",
    "pack:sdk": "node bin/bun.mjs run pack:sdk:pinned",
    "pack:sdk:pinned": "bun -e \"const {spawnSync}=await import('node:child_process'); const path=await import('node:path'); const result=spawnSync(process.execPath,['--no-env-file','--no-install','--config='+path.resolve('bunfig.toml'),'tooling/pack-sdk.mjs','--pack','--root',process.cwd(),'--destination',path.resolve('.tmp/sdk-package')],{stdio:'inherit',windowsHide:true}); if(result.error)throw result.error; process.exit(result.status??1);\"",
    "test:repair": "node bin/bun.mjs run test:repair:pinned",
    "test:repair:pinned": "bun test tests/runtime-config-rebind.test.mjs tests/historical-terminal-synthesis-capture.test.mjs tests/documentation-policy-transition.test.mjs tests/completed-readonly-capture.test.mjs tests/repair-cli-behavior.test.mjs tests/read-only-dispatch-repair.test.mjs tests/reconcile-readonly-dispatch.test.mjs tests/paused-replacement-entrypoint.test.mjs tests/interrupted-source-retirement.test.mjs tests/release-retarget-state.test.mjs tests/native-delivery-evidence-repair.test.mjs",
    "build:standalone": "node bin/bun.mjs run build:standalone:pinned",
    "build:standalone:pinned": "bun tooling/build-standalone.mjs --build",
    "test:resources": "node bin/bun.mjs run test:resources:pinned",
    "test:resources:pinned": "bun test tests/standalone.test.mjs",
    "local:candidate": "node bin/bun.mjs run local:candidate:pinned",
    "local:candidate:pinned": "bun run test:toolchain:pinned && bun run preflight:pinned && bun run test:pinned && bun run test:repair:pinned && bun run test:host-state:pinned && bun run test:run-entrypoint:pinned && bun run test:resources:pinned && bun run test:fuzz:pinned && bun run test:zombies:pinned && bun run test:deep:pinned && bun run quality:static:pinned && bun run test:coverage:pinned && bun run coverage:gate:pinned && bun run crap:pinned && bun run format:check:pinned"
  },
