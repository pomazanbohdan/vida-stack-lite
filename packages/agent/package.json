  "scripts": {
    "bun:version": "node bin/bun.mjs run bun:version:pinned",
    "bun:version:pinned": "bun --version && bun --revision",
    "preflight": "node bin/bun.mjs run preflight:pinned",
    "preflight:pinned": "bun -e \"const {existsSync}=await import('node:fs');const forbidden=['config/agent-profiles.v1.json','config/authorization/cedar-policy.v1.cedar','config/authorization/cedar-schema.v1.json','config/differential-normalization.v1.json','config/governance/edictum-policy.v1.json','config/integrations/edictum-workflow.v1.yml','config/orchestration/mastra-policy.v1.json','config/platform-knowledge.sources.json','config/runtime-operations.v1.json','dist/schemas/runtime-config.v1.schema.json','schemas/runtime-config.v1.schema.json'];const present=forbidden.filter(existsSync);if(present.length){console.error('candidate preflight found obsolete files:\\n'+present.join('\\n'));process.exit(1)}\"",
    "clean": "node bin/bun.mjs run clean:pinned",
    "clean:pinned": "bun tooling/clean.mjs",
    "fingerprint": "node bin/bun.mjs run fingerprint:pinned",
    "fingerprint:pinned": "bun tooling/fingerprint.mjs",
    "clean:dist": "node bin/bun.mjs run clean:dist:pinned",
    "clean:dist:pinned": "bun tooling/clean.mjs --dist-only",
    "typecheck": "node bin/bun.mjs run typecheck:pinned",
    "typecheck:pinned": "tsc --ignoreConfig --target ES2024 --lib ES2024 --module NodeNext --moduleResolution NodeNext --strict --noUncheckedIndexedAccess --exactOptionalPropertyTypes --verbatimModuleSyntax --isolatedModules --resolveJsonModule --esModuleInterop --forceConsistentCasingInFileNames --skipLibCheck --types node,bun --noEmit src/index.ts src/config/index.ts src/runtime-kernel.ts src/trusted-host.ts",
    "build": "node bin/bun.mjs run build:pinned",
    "build:pinned": "bun run preflight:pinned && bun run clean:dist:pinned && tsc --ignoreConfig --target ES2024 --lib ES2024 --module NodeNext --moduleResolution NodeNext --strict --noUncheckedIndexedAccess --exactOptionalPropertyTypes --verbatimModuleSyntax --isolatedModules --resolveJsonModule --esModuleInterop --forceConsistentCasingInFileNames --skipLibCheck --types node,bun --rootDir src --outDir dist/src --declaration --emitDeclarationOnly src/index.ts src/config/index.ts src/trusted-host.ts src/runtime-kernel.ts && bun tooling/build-package.mjs",
    "prepack": "node bin/bun.mjs run prepack:pinned",
    "prepack:pinned": "bun tooling/pack-sdk.mjs --verify && bun tooling/build-standalone.mjs --build --quiet",
    "test:config": "node bin/bun.mjs run test:config:pinned",
    "test:config:pinned": "bun test tests/runtime-config-yaml.test.mjs tests/runtime-config-repair-boundary.test.mjs",
    "test:research-decision": "node bin/bun.mjs run test:research-decision:pinned",
    "test:research-decision:pinned": "bun test tests/research-source-catalog.test.mjs",
    "test": "node bin/bun.mjs run test:pinned && node bin/bun.mjs run test:repair:pinned && node bin/bun.mjs run test:host-state:pinned && node bin/bun.mjs run test:run-entrypoint:pinned",
    "test:pinned": "bun test tests/cedar-validation.test.mjs tests/runtime-config-yaml.test.mjs tests/runtime-config-repair-boundary.test.mjs tests/runtime-timing-output.test.mjs tests/bun-cache-routing.test.mjs tests/forward-candidate-admission.test.mjs tests/forward-candidate-authority.test.mjs tests/smoke.test.mjs tests/property.test.mjs tests/research-source-catalog.test.mjs tests/portable-instructions.test.mjs tests/initialization.test.mjs tests/bun/persistent-session-handoff.test.mjs tests/bun/runtime-initialization.test.mjs tests/admitted-synthesis-projection.test.mjs tests/observed-testing.test.mjs tests/admitted-development-packet.test.mjs tests/observed-research-result.test.mjs tests/session-handoff.test.mjs tests/bun/task-source-binding.test.mjs tests/task-source-binding-operations.test.mjs tests/source-preflight.test.mjs tests/source-preflight-producer.test.mjs tests/initial-source-continuation.test.mjs tests/delivered-work-continuation.test.mjs tests/version-policy.test.mjs",
    "test:run-entrypoint": "node bin/bun.mjs run test:run-entrypoint:pinned",
    "test:run-entrypoint:pinned": "bun test tests/run-entrypoint.test.mjs",
    "test:property": "node bin/bun.mjs run test:property:pinned",
    "test:property:pinned": "bun test tests/property.test.mjs",
    "test:deep": "node bin/bun.mjs run test:deep:pinned",
    "test:deep:pinned": "bun tooling/run-property.mjs",
    "test:deep:built:pinned": "bun tooling/run-property.mjs",
    "test:fuzz": "node bin/bun.mjs run test:fuzz:pinned",
    "test:fuzz:pinned": "bun --bun node_modules/vitest/vitest.mjs run --config vitest.config.mjs tests/fuzz.test.mjs",
    "test:fuzz:built:pinned": "bun --bun node_modules/vitest/vitest.mjs run --config vitest.config.mjs tests/fuzz.test.mjs",
    "test:zombies": "node bin/bun.mjs run test:zombies:pinned",
    "test:zombies:pinned": "bun --bun node_modules/vitest/vitest.mjs run --config vitest.config.mjs tests/zombies.test.mjs",
    "test:zombies:built:pinned": "bun --bun node_modules/vitest/vitest.mjs run --config vitest.config.mjs tests/zombies.test.mjs",
    "test:portable": "node bin/bun.mjs run test:portable:pinned",
    "test:portable:pinned": "bun test tests/smoke.test.mjs tests/property.test.mjs tests/portable-instructions.test.mjs",
