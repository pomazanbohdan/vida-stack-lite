    "test:coverage": "node bin/bun.mjs run test:coverage:pinned",
    "test:coverage:pinned": "bun tooling/coverage-gate.mjs --begin-v8 && bun --env-file=tooling/v8-coverage.env --bun node_modules/vitest/vitest.mjs run --config vitest.config.mjs --coverage && bun tooling/coverage-gate.mjs --stamp-v8 && bun tooling/run-bun-native-coverage.mjs && bun tooling/coverage-gate.mjs --stamp-native",
    "test:coverage:built:pinned": "bun tooling/coverage-gate.mjs --begin-v8 && bun --env-file=tooling/v8-coverage.env --bun node_modules/vitest/vitest.mjs run --config vitest.config.mjs --coverage && bun tooling/coverage-gate.mjs --stamp-v8 && bun tooling/run-bun-native-coverage.mjs && bun tooling/coverage-gate.mjs --stamp-native",
