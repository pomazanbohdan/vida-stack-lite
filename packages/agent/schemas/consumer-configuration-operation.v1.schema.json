{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-runtime.invalid/schemas/consumer-configuration-operation.v1.schema.json",
  "title": "Consumer Configuration Operation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "operation_id", "root", "root_identity", "workspace_id", "request", "binding", "before", "target", "receipt", "progress"],
  "properties": {
    "schema": { "const": "ConsumerConfigurationOperation/v1" },
    "version": { "const": 1 },
    "operation_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "root": { "type": "string", "minLength": 1 },
    "root_identity": { "type": "string", "minLength": 1 },
    "workspace_id": { "$ref": "#/$defs/digest" },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["projectRoot", "repository", "projectMappings"],
      "properties": {
        "projectRoot": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "projectMappings": { "type": "array", "items": { "type": "string" } },
        "teamProjectGrants": { "type": "array", "items": { "type": "string" } },
        "projectMoves": { "type": "array", "maxItems": 10000, "items": { "type": "string", "maxLength": 4096 } }
      }
    },
    "binding": { "$ref": "#/$defs/digest" },
    "before": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/bytes" } },
    "target": { "$ref": "#/$defs/bytes" },
    "receipt": { "oneOf": [
      { "type": "null" },
      { "type": "object", "additionalProperties": false, "required": ["before", "target"],
        "properties": { "before": { "$ref": "#/$defs/bytes" }, "target": { "$ref": "#/$defs/bytes" } } }
    ] },
    "progress": { "enum": ["intent", "config_applied", "receipt_applied", "complete"] },
    "relocation": { "$ref": "#/$defs/relocation" }
  },
  "$defs": {
    "state": { "enum": ["not-started", "issued", "completed"] },
    "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "identity": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "relocation": {
      "type": "object", "additionalProperties": false, "required": ["inventory", "policy"],
      "properties": {
        "inventory": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "$ref": "#/$defs/inventory" } },
        "policy": { "type": "object", "additionalProperties": false, "required": ["before", "target", "state"],
          "properties": { "before": { "$ref": "#/$defs/relocationBytes" }, "target": { "$ref": "#/$defs/relocationBytes" }, "state": { "$ref": "#/$defs/state" } } }
      }
    },
    "inventory": {
      "type": "object", "additionalProperties": false, "required": ["move", "rootIdentity", "destinationIdentity", "directories", "files"],
      "properties": {
        "move": { "type": "object", "additionalProperties": false, "required": ["id", "oldRoot", "newRoot"], "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 }, "oldRoot": { "$ref": "#/$defs/path" }, "newRoot": { "$ref": "#/$defs/path" } } },
        "rootIdentity": { "$ref": "#/$defs/identity" }, "destinationIdentity": { "$ref": "#/$defs/identity" },
        "targetDirectories": { "type": "array", "maxItems": 10000, "items": { "type": "object", "additionalProperties": false,
          "required": ["path", "identity"], "properties": { "path": { "$ref": "#/$defs/path" }, "identity": { "$ref": "#/$defs/identity" } } } },
        "pendingDirectory": { "$ref": "#/$defs/path" },
        "directories": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "type": "object", "additionalProperties": false,
          "required": ["path", "identity", "entries"], "properties": { "path": { "$ref": "#/$defs/path" }, "identity": { "$ref": "#/$defs/identity" },
            "entries": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/path" } } } } },
        "files": { "type": "array", "maxItems": 10000, "items": { "type": "object", "additionalProperties": false,
          "required": ["source", "destination", "identity", "sha256", "size", "state"], "properties": {
            "source": { "$ref": "#/$defs/path" }, "destination": { "$ref": "#/$defs/path" }, "identity": { "$ref": "#/$defs/identity" },
            "sha256": { "$ref": "#/$defs/digest" }, "size": { "type": "integer", "minimum": 0, "maximum": 33554432 }, "state": { "$ref": "#/$defs/state" } } } }
      }
    },
    "relocationBytes": { "allOf": [{ "$ref": "#/$defs/bytes" }, { "type": "object", "properties": { "base64": { "type": "string", "maxLength": 44739244 } } }] },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "bytes": {
      "type": "object", "additionalProperties": false, "required": ["base64", "sha256"],
      "properties": {
        "base64": { "type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
