{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-runtime.invalid/schemas/runtime-initialization.v2.schema.json",
  "title": "Project runtime initialization receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "provenance",
    "repository_id",
    "project_ids",
    "workspace_id",
    "workspace_binding_status",
    "bundle",
    "bundle_digest",
    "config_digest",
    "input_digest",
    "current_config_digest",
    "current_input_digest",
    "configuration_rebind_id",
    "operation_id",
    "database_path",
    "configuration_inputs",
    "prepared_artifacts",
    "created_at"
  ],
  "properties": {
    "schema": { "const": "RuntimeInitialization/v2" },
    "version": { "const": 2 },
    "provenance": { "const": "project-upgrade" },
    "repository_id": { "$ref": "#/$defs/slug" },
    "project_ids": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/slug" } },
    "workspace_id": { "$ref": "#/$defs/hash" },
    "workspace_binding_status": { "enum": ["pending", "bound"] },
    "bundle": { "type": "string", "minLength": 1 },
    "bundle_digest": { "$ref": "#/$defs/hash" },
    "config_digest": { "$ref": "#/$defs/hash" },
    "input_digest": { "$ref": "#/$defs/hash" },
    "current_config_digest": { "$ref": "#/$defs/hash" },
    "current_input_digest": { "$ref": "#/$defs/hash" },
    "configuration_rebind_id": {
      "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" }]
    },
    "operation_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
    "database_path": { "const": ".vida/work/workspace.v1.sqlite" },
    "configuration_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "agents", "flows"],
      "properties": {
        "project": { "const": ".vida/project.yaml" },
        "agents": { "const": ".vida/agents.yaml" },
        "flows": { "const": ".vida/flows.yaml" }
      }
    },
    "prepared_artifacts": {
      "type": "array",
      "minItems": 8,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }
  }
}
