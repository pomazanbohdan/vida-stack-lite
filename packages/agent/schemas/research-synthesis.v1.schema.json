{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vida-agent.invalid/schemas/research-synthesis.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "bundle_id",
    "work_item_id",
    "source_revision",
    "scope_id",
    "topic",
    "result_refs",
    "findings",
    "uncertainties",
    "conflicts",
    "br_ids",
    "sr_ids",
    "ac_ids",
    "gap_ids",
    "options",
    "recommendation",
    "completeness",
    "readiness",
    "instruction_activation",
    "actor",
    "pointer",
    "created_at",
    "updated_at",
    "digest"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "schema": {
      "const": "ResearchSynthesis/v1"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "work_item_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "result_refs": {
      "type": "array",
      "description": "Exact predecessor ResearchResult IDs and digests in bytewise ascending result_id order. Their array index defines the rN prefix used by source citations.",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["result_id", "digest"],
        "properties": {
          "result_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "statement", "source_refs", "evidence_class", "status"],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "source_refs": {
            "type": "array",
            "description": "Qualified rN:<local source_id> keys from the exact result_refs catalog; local IDs alone are not valid synthesis citations.",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "evidence_class": {
            "enum": ["Decision", "Code", "Static", "Runtime", "GAP"]
          },
          "status": {
            "enum": ["confirmed", "tentative", "unknown"]
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uncertainty_id", "statement", "material"],
        "properties": {
          "uncertainty_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "material": {
            "type": "boolean"
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conflict_id", "statement", "source_refs", "status"],
        "properties": {
          "conflict_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "source_refs": {
            "type": "array",
            "description": "Qualified rN:<local source_id> keys from the exact result_refs catalog; local IDs alone are not valid synthesis citations.",
            "minItems": 2,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "status": {
            "enum": ["open", "reconciled", "accepted_unknown"]
          }
        }
      }
    },
    "br_ids": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "sr_ids": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "ac_ids": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "gap_ids": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option_id", "label", "description", "evidence_refs"],
        "properties": {
          "option_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "evidence_refs": {
            "type": "array",
            "description": "Qualified rN:<local source_id> keys from the exact result_refs catalog.",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      }
    },
    "recommendation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["option_id", "rationale", "evidence_refs"],
      "properties": {
        "option_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "evidence_refs": {
          "type": "array",
          "description": "Qualified rN:<local source_id> keys from the exact result_refs catalog.",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "required_questions",
        "answered_questions",
        "missing_questions",
        "material_gaps",
        "external_validation"
      ],
      "properties": {
        "status": {
          "enum": ["pass", "blocked"]
        },
        "required_questions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "answered_questions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "missing_questions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "material_gaps": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "external_validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "source_count", "minimum_sources", "status", "live_check"],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "source_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "minimum_sources": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "status": {
              "enum": ["pass", "blocked", "not_required"]
            },
            "live_check": {
              "type": ["boolean", "null"]
            }
          }
        }
      }
    },
    "readiness": {
      "enum": ["ready", "blocked", "informational"]
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "pointer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
