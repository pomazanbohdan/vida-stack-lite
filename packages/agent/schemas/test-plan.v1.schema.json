{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-runtime.invalid/schemas/test-plan.v1.schema.json",
  "title": "Test Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "work_id", "attempt", "packet_id", "task_contract_digest", "scenarios"],
  "properties": {
    "schema": { "const": "TestPlan/v1" },
    "version": { "const": 1 },
    "work_id": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "task_contract_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scenarios": {
      "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "string", "minLength": 1 }, "description": { "type": "string" } } }
    }
  }
}
