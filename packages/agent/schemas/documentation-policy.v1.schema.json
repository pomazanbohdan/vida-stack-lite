{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vida-agent.invalid/schemas/documentation-policy.v1.schema.json",
  "title": "DocumentationPolicy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_id", "project_id", "source_path", "owner", "required", "canonical_roots", "map_paths", "excluded_roots", "changelog_required", "relations", "updated_at"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema": {"const": "DocumentationPolicy/v1"},
    "policy_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "source_path": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "required": {"type": "boolean"},
    "canonical_roots": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "map_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "excluded_roots": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "changelog_required": {"type": "boolean"},
    "changelog_path": {"type": ["string", "null"], "minLength": 1},
    "relations": {"type": "array", "uniqueItems": true, "items": {"enum": ["owns", "depends_on", "affects", "implements", "verifies", "documents", "supersedes", "migrates_from"]}},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
