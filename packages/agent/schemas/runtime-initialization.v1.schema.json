{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-runtime.invalid/schemas/runtime-initialization.v1.schema.json",
  "title": "Runtime Initialization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "repository_id",
    "project_ids",
    "integrations_digest",
    "workspace_id",
    "workspace_binding_status",
    "bundle",
    "config_digest",
    "schema_sha256",
    "templates",
    "created_at"
  ],
  "properties": {
    "schema": {
      "const": "RuntimeInitialization/v1"
    },
    "version": {
      "const": 1
    },
    "provenance": {
      "enum": ["generated", "adopted_existing"]
    },
    "repository_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "project_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }
    },
    "integrations_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "workspace_binding_status": { "enum": ["pending", "bound"] },
    "workspace_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "bundle": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "config_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "schema_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "templates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["template", "template_sha256", "output", "output_sha256"],
          "properties": {
            "template": {
              "const": "templates/AGENTS.template.md"
            },
            "output": {
              "const": "AGENTS.md"
            },
            "template_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "output_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["template", "template_sha256", "output", "output_sha256"],
          "properties": {
            "template": {
              "const": "templates/AGENT.sidecar.template.md"
            },
            "output": {
              "const": "AGENT.sidecar.md"
            },
            "template_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "output_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["template", "template_sha256", "output", "output_sha256"],
          "properties": {
            "template": {
              "const": "templates/agent-runtime.config.template.v1.yaml"
            },
            "output": {
              "const": "agent-runtime.config.v1.yaml"
            },
            "template_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "output_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["template", "template_sha256", "output", "output_sha256"],
          "properties": {
            "template": { "const": "templates/documentation-policy.template.v1.json" },
            "output": { "const": "docs/agent-instructions/documentation-policy.v1.json" },
            "template_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "output_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      ],
      "items": false
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
