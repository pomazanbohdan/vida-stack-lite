{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vida-agent.invalid/schemas/implementation-scope.v1.schema.json",
  "title": "ImplementationScope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scope_id",
    "work_id",
    "source_revision",
    "ac_ids",
    "allowed_paths",
    "implementation_paths",
    "changed_symbols",
    "non_goals",
    "acceptance_trace",
    "behavior_trace",
    "test_trace",
    "diagnostic_trace",
    "attribution",
    "owner",
    "created_at"
  ],
  "properties": {
    "schema": { "const": "ImplementationScope/v1" },
    "scope_id": { "type": "string", "minLength": 1 },
    "work_id": { "type": "string", "minLength": 1 },
    "source_revision": { "type": "string", "minLength": 1 },
    "ac_ids": { "$ref": "#/$defs/nonEmptyStringSet" },
    "allowed_paths": { "$ref": "#/$defs/nonEmptyStringSet" },
    "implementation_paths": { "$ref": "#/$defs/nonEmptyStringSet" },
    "documentation_paths": { "$ref": "#/$defs/stringSet" },
    "changed_symbols": { "$ref": "#/$defs/stringSet" },
    "non_goals": { "$ref": "#/$defs/stringSet" },
    "acceptance_trace": { "$ref": "#/$defs/nonEmptyStringSet" },
    "behavior_trace": { "$ref": "#/$defs/nonEmptyStringSet" },
    "test_trace": { "$ref": "#/$defs/nonEmptyStringSet" },
    "diagnostic_trace": { "$ref": "#/$defs/nonEmptyStringSet" },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thread_id", "pointer"],
      "properties": {
        "thread_id": { "type": "string", "minLength": 1 },
        "pointer": { "type": "string", "minLength": 1 }
      }
    },
    "owner": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonEmptyStringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
