{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vida-agent.invalid/schemas/acceptance-manifest.v1.schema.json",
  "title": "AcceptanceManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "ac_ids",
    "source",
    "scope",
    "source_revision",
    "contracts"
  ],
  "properties": {
    "schema": { "const": "AcceptanceManifest/v1" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "ac_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "source": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "source_revision": { "type": "string", "minLength": 1 },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/contract" }
    }
  },
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "definition", "sr", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "definition": { "type": "string", "minLength": 1 },
        "sr": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
