{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vida-agent.invalid/schemas/governed-write-intent.v1.schema.json",
  "title": "Candidate governed write intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "payload", "authorization", "approval"],
  "properties": {
    "operation": { "type": "string", "minLength": 1 },
    "payload": { "type": "object", "additionalProperties": true },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
        "required": ["principal", "role", "action", "tenant", "project", "resourceTenant", "resourceProject", "registryHash"],
      "properties": {
        "principal": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "action": { "const": "write" },
        "tenant": { "type": "string", "minLength": 1 },
        "project": { "type": "string", "minLength": 1 },
        "resourceTenant": { "type": "string", "minLength": 1 },
        "resourceProject": { "type": "string", "minLength": 1 },
        "registryHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "decision_id", "approver", "tenant", "project", "operation_hash", "approved_at", "expires_at"],
      "properties": {
        "decision": { "const": "approved" },
        "decision_id": { "type": "string", "minLength": 1 },
        "approver": { "type": "string", "minLength": 1 },
        "tenant": { "type": "string", "minLength": 1 },
        "project": { "type": "string", "minLength": 1 },
        "operation_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "approved_at": {"type":"string","pattern":"^(?:(?:\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8]))T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?(?:Z|[+-](?:0\\d|1\\d|2[0-3]):[0-5]\\d))|(?:(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?(?:Z|[+-](?:0\\d|1\\d|2[0-3]):[0-5]\\d))|(?:(?:1972-06-30|1972-12-31|1973-12-31|1974-12-31|1975-12-31|1976-12-31|1977-12-31|1978-12-31|1979-12-31|1981-06-30|1982-06-30|1983-06-30|1985-06-30|1987-12-31|1989-12-31|1990-12-31|1992-06-30|1993-06-30|1994-06-30|1995-12-31|1997-06-30|1998-12-31|2005-12-31|2008-12-31|2012-06-30|2015-06-30|2016-12-31)T23:59:60(?:\\.\\d{1,9})?(?:Z|\\+00:00)))$"},
        "expires_at": {"type":"string","pattern":"^(?:(?:\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8]))T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?(?:Z|[+-](?:0\\d|1\\d|2[0-3]):[0-5]\\d))|(?:(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?(?:Z|[+-](?:0\\d|1\\d|2[0-3]):[0-5]\\d))|(?:(?:1972-06-30|1972-12-31|1973-12-31|1974-12-31|1975-12-31|1976-12-31|1977-12-31|1978-12-31|1979-12-31|1981-06-30|1982-06-30|1983-06-30|1985-06-30|1987-12-31|1989-12-31|1990-12-31|1992-06-30|1993-06-30|1994-06-30|1995-12-31|1997-06-30|1998-12-31|2005-12-31|2008-12-31|2012-06-30|2015-06-30|2016-12-31)T23:59:60(?:\\.\\d{1,9})?(?:Z|\\+00:00)))$"}
      }
    }
  }
}
