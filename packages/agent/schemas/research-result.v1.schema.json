        "required_questions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "answered_questions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "missing_questions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "material_gaps": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "external_validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "source_count",
            "minimum_sources",
            "status",
            "live_check"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "source_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "minimum_sources": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "status": {
              "enum": [
                "pass",
                "blocked",
                "not_required"
              ]
            },
            "live_check": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        }
      }
