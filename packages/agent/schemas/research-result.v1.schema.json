    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "contour": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
