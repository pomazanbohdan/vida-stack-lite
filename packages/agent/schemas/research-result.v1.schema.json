            "type": "boolean"
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conflict_id",
          "statement",
          "source_ids",
          "status"
        ],
        "properties": {
          "conflict_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
