          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "evidence_class": {
            "enum": [
              "Decision",
              "Code",
              "Static",
              "Runtime",
              "GAP"
            ]
          },
          "status": {
            "enum": [
              "confirmed",
              "tentative",
              "unknown"
            ]
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 64,
