      "type": "string",
      "minLength": 1,
            "pattern": "^(?:(?:(?:\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8])))|(?:(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00))-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?(?:Z|[+-](?:0\\d|1\\d|2[0-3]):[0-5]\\d)|(?:(?:1972-06-30|1972-12-31|1973-12-31|1974-12-31|1975-12-31|1976-12-31|1977-12-31|1978-12-31|1979-12-31|1981-06-30|1982-06-30|1983-06-30|1985-06-30|1987-12-31|1989-12-31|1990-12-31|1992-06-30|1993-06-30|1994-06-30|1995-12-31|1997-06-30|1998-12-31|2005-12-31|2008-12-31|2012-06-30|2015-06-30|2016-12-31))T23:59:60(?:\\.\\d{1,9})?(?:Z|\\+00:00))$"
    },
    "updated_at": {
      "type": "string",
      "minLength": 1,
            "pattern": "^(?:(?:(?:\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8])))|(?:(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00))-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?(?:Z|[+-](?:0\\d|1\\d|2[0-3]):[0-5]\\d)|(?:(?:1972-06-30|1972-12-31|1973-12-31|1974-12-31|1975-12-31|1976-12-31|1977-12-31|1978-12-31|1979-12-31|1981-06-30|1982-06-30|1983-06-30|1985-06-30|1987-12-31|1989-12-31|1990-12-31|1992-06-30|1993-06-30|1994-06-30|1995-12-31|1997-06-30|1998-12-31|2005-12-31|2008-12-31|2012-06-30|2015-06-30|2016-12-31))T23:59:60(?:\\.\\d{1,9})?(?:Z|\\+00:00))$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "instruction_activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "use_id",
        "risk",
        "phase",
        "lane",
        "trigger",
        "required_instruction_ids",
        "instruction_ids",
        "registry_digest",
        "source_digests"
      ],
      "properties": {
        "use_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,255}$"
        },
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "phase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "lane": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "trigger": {
          "enum": [
            "research_intent",
            "domain_question",
            "external_fact",
            "api_assumption",
            "provider_change"
          ]
        },
        "required_instruction_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          }
        },
        "instruction_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          }
        },
        "registry_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
