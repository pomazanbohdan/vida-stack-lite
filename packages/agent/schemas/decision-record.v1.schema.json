{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vida-agent.invalid/schemas/decision-record.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decision_id",
    "work_item_id",
    "source_revision",
    "scope_id",
    "decision_type",
    "statement",
    "context",
    "options",
    "selected_option_id",
    "rationale",
    "evidence_refs",
    "br_ids",
    "sr_ids",
    "ac_ids",
    "gap_ids",
    "authority",
    "status",
    "supersedes",
    "revisit",
    "instruction_activation",
    "actor",
    "pointer",
    "created_at",
    "updated_at",
    "digest"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "schema": {
      "const": "DecisionRecord/v1"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "work_item_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "decision_type": {
      "enum": [
        "business",
        "technical"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "context": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_id",
          "label",
          "description",
          "status",
          "evidence_refs"
        ],
        "properties": {
          "option_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "status": {
            "enum": [
              "considered",
              "selected",
              "rejected",
              "deferred"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      }
    },
    "selected_option_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "id",
          "digest",
          "pointer"
        ],
        "properties": {
          "kind": {
            "enum": [
              "Decision",
              "Code",
              "Static",
              "Runtime",
              "GAP"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "pointer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "br_ids": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "sr_ids": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "ac_ids": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "gap_ids": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "actor",
        "pointer",
        "proof"
      ],
      "properties": {
        "kind": {
          "enum": [
            "user",
            "owner",
            "runtime_architect",
            "architect",
            "agent"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "pointer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "proof": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "evidence_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "checkpoint_revision": {
          "type": "integer",
          "minimum": 1
        },
        "checkpoint_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "deferred",
        "superseded"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "revisit": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "trigger",
        "condition"
      ],
      "properties": {
        "trigger": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "condition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "pointer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:(?:(?:\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8])))|(?:(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00))-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?(?:Z|[+-](?:0\\d|1\\d|2[0-3]):[0-5]\\d)|(?:(?:1972-06-30|1972-12-31|1973-12-31|1974-12-31|1975-12-31|1976-12-31|1977-12-31|1978-12-31|1979-12-31|1981-06-30|1982-06-30|1983-06-30|1985-06-30|1987-12-31|1989-12-31|1990-12-31|1992-06-30|1993-06-30|1994-06-30|1995-12-31|1997-06-30|1998-12-31|2005-12-31|2008-12-31|2012-06-30|2015-06-30|2016-12-31))T23:59:60(?:\\.\\d{1,9})?(?:Z|\\+00:00))$"
    },
    "updated_at": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:(?:(?:\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8])))|(?:(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00))-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?(?:Z|[+-](?:0\\d|1\\d|2[0-3]):[0-5]\\d)|(?:(?:1972-06-30|1972-12-31|1973-12-31|1974-12-31|1975-12-31|1976-12-31|1977-12-31|1978-12-31|1979-12-31|1981-06-30|1982-06-30|1983-06-30|1985-06-30|1987-12-31|1989-12-31|1990-12-31|1992-06-30|1993-06-30|1994-06-30|1995-12-31|1997-06-30|1998-12-31|2005-12-31|2008-12-31|2012-06-30|2015-06-30|2016-12-31))T23:59:60(?:\\.\\d{1,9})?(?:Z|\\+00:00))$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "instruction_activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "use_id",
        "risk",
        "phase",
        "lane",
        "trigger",
        "required_instruction_ids",
        "instruction_ids",
        "registry_digest",
        "source_digests"
      ],
      "properties": {
        "use_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,255}$"
        },
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "phase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "lane": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "trigger": {
          "enum": [
            "option_selection",
            "decision_needed",
            "conflict",
            "material_gap",
            "supersession",
            "correction",
            "closeout"
          ]
        },
        "required_instruction_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          }
        },
        "instruction_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          }
        },
        "registry_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_digests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "instruction_id",
              "source_sha256"
            ],
            "properties": {
              "instruction_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "accepted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "br_ids": {
            "type": "array",
            "minItems": 1
          },
          "sr_ids": {
            "type": "array",
            "minItems": 1
          },
          "ac_ids": {
            "type": "array",
            "minItems": 1
          },
          "authority": {
            "type": "object",
            "required": [
              "evidence_digest",
              "checkpoint_revision",
              "checkpoint_digest"
            ],
            "properties": {
              "evidence_digest": {},
              "checkpoint_revision": {},
              "checkpoint_digest": {}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "accepted"
          },
          "decision_type": {
            "const": "business"
          }
        },
        "required": [
          "status",
          "decision_type"
        ]
      },
      "then": {
        "properties": {
          "authority": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "user",
                  "owner"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "accepted"
          },
          "decision_type": {
            "const": "technical"
          }
        },
        "required": [
          "status",
          "decision_type"
        ]
      },
      "then": {
        "properties": {
          "authority": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "runtime_architect",
                  "architect"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
