{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-runtime.invalid/schemas/consumer-clean-initialization-operation.v2.schema.json",
  "title": "Consumer Clean Initialization Operation v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "operation_id",
    "root",
    "root_identity",
    "workspace_id",
    "request",
    "runtime",
    "archive_root",
    "inventory",
    "preserved",
    "protected_paths",
    "moves",
    "containers",
    "phase",
    "prepared",
    "initialization",
    "binding"
  ],
  "properties": {
    "schema": { "const": "ConsumerCleanInitializationOperation/v2" },
    "version": { "const": 2 },
    "operation_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "root": { "$ref": "#/$defs/text" },
    "root_identity": { "$ref": "#/$defs/identity" },
    "workspace_id": { "$ref": "#/$defs/digest" },
    "request": { "$ref": "#/$defs/request" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "archive_root": { "$ref": "#/$defs/path" },
    "inventory": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/file" } },
    "preserved": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/file" } },
    "protected_paths": { "type": "array", "minItems": 2, "maxItems": 256, "items": { "$ref": "#/$defs/path" } },
    "moves": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/move" } },
    "containers": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/container" } },
    "phase": { "enum": ["intent", "archiving", "archive_complete", "initializing", "complete"] },
    "prepared": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/prepared" }] },
    "initialization": { "$ref": "#/$defs/state" },
    "binding": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "identity": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "state": { "enum": ["not-started", "issued", "completed"] },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectRoot", "repository", "projectMappings"],
      "properties": {
        "projectRoot": { "$ref": "#/$defs/path" },
        "repository": { "$ref": "#/$defs/text" },
        "projectMappings": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "$ref": "#/$defs/text" } },
        "reconcileExisting": { "const": false }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "bundle_identity", "resource_digest"],
      "properties": {
        "version": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "bundle_identity": { "$ref": "#/$defs/identity" },
        "resource_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "identity", "size", "sha256"],
      "properties": {
        "type": { "const": "file" },
        "path": { "$ref": "#/$defs/path" },
        "identity": { "$ref": "#/$defs/identity" },
        "size": { "type": "integer", "minimum": 0, "maximum": 67108864 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "move": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "target", "source_identity", "type", "state"],
      "properties": {
        "kind": { "const": "archive" },
        "source": { "$ref": "#/$defs/path" },
        "target": { "$ref": "#/$defs/path" },
        "source_identity": { "$ref": "#/$defs/identity" },
        "type": { "const": "file" },
        "state": { "$ref": "#/$defs/state" }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "state", "identity"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "state": { "$ref": "#/$defs/state" },
        "identity": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/identity" }] }
      }
    },
    "prepared": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "rootIdentity", "bundleIdentity", "projectIdentities", "resourceDigest"],
      "properties": {
        "intent": { "type": "string", "minLength": 1, "maxLength": 8388608 },
        "rootIdentity": { "$ref": "#/$defs/identity" },
        "bundleIdentity": { "$ref": "#/$defs/identity" },
        "projectIdentities": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/identity" } },
        "resourceDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
