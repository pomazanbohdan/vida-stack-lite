{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vida-agent.invalid/schemas/instruction-registry.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "registry_id",
    "revision",
    "source_revision",
    "instructions",
    "updated_at",
    "digest"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "schema": {
      "const": "InstructionRegistry/v1"
    },
    "registry_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instruction_id",
          "owner",
          "revision",
          "source_path",
          "source_sha256",
          "summary_sha256",
          "activation_class",
          "triggers",
          "phases",
          "lanes",
          "output_schema",
          "max_bytes",
          "privacy",
          "status",
          "content"
        ],
        "properties": {
          "instruction_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "source_path": {
            "type": "string",
            "pattern": "^agent-runtime\\.config\\.v1\\.yaml#research_decision\\.registry\\.instructions\\.[0-9]+$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "summary_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "activation_class": {
            "enum": [
              "always_on",
              "lane_entry",
              "triggered_domain",
              "closure_reflection"
            ]
          },
          "triggers": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]{0,127}$"
            }
          },
          "phases": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]{0,127}$"
            }
          },
          "lanes": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]{0,127}$"
            }
          },
          "output_schema": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]+/v1$"
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 4194304
          },
          "privacy": {
            "enum": [
              "public",
              "internal",
              "sensitive_redacted"
            ]
          },
          "status": {
            "enum": [
              "active",
              "disabled"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          }
        }
      }
    },
    "updated_at": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:(?:(?:\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8])))|(?:(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00))-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?(?:Z|[+-](?:0\\d|1\\d|2[0-3]):[0-5]\\d)|(?:(?:1972-06-30|1972-12-31|1973-12-31|1974-12-31|1975-12-31|1976-12-31|1977-12-31|1978-12-31|1979-12-31|1981-06-30|1982-06-30|1983-06-30|1985-06-30|1987-12-31|1989-12-31|1990-12-31|1992-06-30|1993-06-30|1994-06-30|1995-12-31|1997-06-30|1998-12-31|2005-12-31|2008-12-31|2012-06-30|2015-06-30|2016-12-31))T23:59:60(?:\\.\\d{1,9})?(?:Z|\\+00:00))$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
