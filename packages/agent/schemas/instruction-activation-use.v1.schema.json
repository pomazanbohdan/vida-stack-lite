{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vida-agent.invalid/schemas/instruction-activation-use.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "use_id",
    "work_item_id",
    "source_revision",
    "scope_id",
    "risk",
    "phase",
    "lane",
    "trigger",
    "required_instruction_ids",
    "instruction_ids",
    "registry_digest",
    "source_digests",
    "cache_status",
    "actor",
    "pointer",
    "timestamp",
    "digest"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "schema": {
      "const": "InstructionActivationUse/v1"
    },
    "use_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,255}$"
    },
    "work_item_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "phase": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "lane": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "trigger": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "required_instruction_ids": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
      }
    },
    "instruction_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "minItems": 1
    },
    "registry_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_digests": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instruction_id",
          "source_sha256"
        ],
        "properties": {
          "instruction_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 1
    },
    "cache_status": {
      "enum": [
        "cold",
        "hit",
        "refreshed"
      ]
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "pointer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "timestamp": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:(?:(?:\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8])))|(?:(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00))-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?(?:Z|[+-](?:0\\d|1\\d|2[0-3]):[0-5]\\d)|(?:(?:1972-06-30|1972-12-31|1973-12-31|1974-12-31|1975-12-31|1976-12-31|1977-12-31|1978-12-31|1979-12-31|1981-06-30|1982-06-30|1983-06-30|1985-06-30|1987-12-31|1989-12-31|1990-12-31|1992-06-30|1993-06-30|1994-06-30|1995-12-31|1997-06-30|1998-12-31|2005-12-31|2008-12-31|2012-06-30|2015-06-30|2016-12-31))T23:59:60(?:\\.\\d{1,9})?(?:Z|\\+00:00))$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    }
  }
}
