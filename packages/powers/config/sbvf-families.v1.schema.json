{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://vida-powers.invalid/schemas/sbvf-families.v1.schema.json",
  "title": "SBVFFamilyManifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "families"],
  "properties": {
    "schema": { "const": "SBVFFamilyManifest/v1" },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family_id", "title", "summary", "rationale", "variants", "approved_by", "approved_at"],
        "properties": {
          "family_id": { "type": "string", "pattern": "^family-[a-z0-9]+(-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
          "summary": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
          "rationale": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
          "variants": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "not": { "pattern": "^family-" }
            }
          },
          "approved_by": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
          "approved_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    }
  }
}
