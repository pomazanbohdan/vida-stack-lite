{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://vida-powers.invalid/schemas/sbvf-admissions.v1.schema.json",
  "title": "SBVFAdmissionManifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "admissions"],
  "properties": {
    "schema": { "const": "SBVFAdmissionManifest/v1" },
    "asOf": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "admissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["variant_id", "family_id", "source", "disposition", "rationale", "approved_by", "approved_at", "evidence"],
        "properties": {
          "variant_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "not": { "pattern": "^family-" }
          },
          "family_id": { "type": "string", "pattern": "^family-[a-z0-9]+(-[a-z0-9]+)*$" },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["donor", "path", "rowKey"],
            "properties": {
              "donor": { "const": "uupm" },
              "path": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
              "rowKey": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" }
            }
          },
          "disposition": { "const": "family-held" },
          "rationale": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
          "approved_by": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
          "approved_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    }
  }
}
