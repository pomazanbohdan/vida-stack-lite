{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VPPluginManifestInputs/v1",
  "type": "object",
  "required": ["schema", "targets", "metadata"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "VPPluginManifestInputs/v1" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["portable", "codex", "claude", "cursor", "root-marketplace", "muse", "muse-package", "muse-catalog", "antigravity", "devin", "kimi"]
      }
    },
    "metadata": { "$ref": "#/definitions/metadata" }
  },
  "definitions": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contact": { "$ref": "#/definitions/contact" },
        "license": { "type": "string", "minLength": 1 },
        "privacyPolicyUrl": { "type": "string", "pattern": "^https://[^\\s]+$" },
        "termsOfServiceUrl": { "type": "string", "pattern": "^https://[^\\s]+$" },
        "category": { "type": "string", "minLength": 1 }
      }
    },
    "contact": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 1 }
      }
    },
    "portablePlugin": {
      "type": "object",
      "required": ["$schema", "name", "version", "description"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "const": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "author": { "$ref": "#/definitions/contact" },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "codexCompatPlugin": {
      "type": "object",
      "required": ["name", "version", "description", "author", "skills", "interface"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "author": { "$ref": "#/definitions/contact" },
        "license": { "type": "string", "minLength": 1 },
        "skills": { "const": "./skills/" },
        "interface": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "developerName": { "type": "string", "minLength": 1 },
            "category": { "type": "string", "minLength": 1 },
            "privacyPolicyURL": { "type": "string", "pattern": "^https://[^\\s]+$" },
            "termsOfServiceURL": { "type": "string", "pattern": "^https://[^\\s]+$" }
          }
        }
      }
    },
    "codexMarketplace": {
      "type": "object",
      "required": ["name", "plugins"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "plugins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "version", "description", "category", "source", "policy"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "license": { "type": "string", "minLength": 1 },
              "category": { "type": "string", "minLength": 1 },
              "source": {
                "type": "object",
                "required": ["source", "path"],
                "additionalProperties": false,
                "properties": {
                  "source": { "const": "local" },
                  "path": { "const": "./" }
                }
              },
              "policy": {
                "type": "object",
                "required": ["installation", "authentication"],
                "additionalProperties": false,
                "properties": {
                  "installation": { "enum": ["AVAILABLE", "INSTALLED_BY_DEFAULT", "NOT_AVAILABLE"] },
                  "authentication": { "enum": ["ON_INSTALL", "ON_FIRST_USE"] }
                }
              }
            }
          }
        }
      }
    },
    "claudePlugin": {
      "type": "object",
      "required": ["name", "version", "description", "skills"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "author": { "$ref": "#/definitions/contact" },
        "license": { "type": "string", "minLength": 1 },
        "skills": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "enum": ["./skills/vp-mode/", "./skills/vp-setup/"] }
        }
      }
    },
    "claudeMarketplace": {
      "type": "object",
      "required": ["name", "description", "owner", "plugins"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "owner": { "$ref": "#/definitions/contact" },
        "plugins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "source", "description", "version"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "source": { "const": "./" },
              "description": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "license": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "cursorPlugin": {
      "type": "object",
      "required": ["name", "version", "description", "skills"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "author": { "$ref": "#/definitions/contact" },
        "license": { "type": "string", "minLength": 1 },
        "skills": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "enum": ["./skills/vp-mode/", "./skills/vp-setup/"] }
        }
      }
    },
    "cursorMarketplace": {
      "type": "object",
      "required": ["name", "owner", "plugins"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "owner": { "$ref": "#/definitions/contact" },
        "plugins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "source", "description", "version"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "source": { "const": "./" },
              "description": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "license": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "musePlugin": {
      "type": "object",
      "required": ["schemaVersion", "name", "version", "description", "compat", "capabilities"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "compat": {
          "type": "object",
          "required": ["manifestDir"],
          "additionalProperties": false,
          "properties": { "manifestDir": { "const": ".muse-plugin" } }
        },
        "capabilities": {
          "type": "object",
          "required": ["skills"],
          "additionalProperties": false,
          "properties": {
            "skills": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": ["id", "path"],
                "additionalProperties": false,
                "properties": {
                  "id": { "enum": ["vp-mode", "vp-setup"] },
                  "path": { "enum": ["skills/vp-mode/SKILL.md", "skills/vp-setup/SKILL.md"] }
                }
              }
            }
          }
        }
      }
    },
    "museMarketplace": {
      "type": "object",
      "required": ["schemaVersion", "source", "plugins"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "source": { "const": "local" },
        "plugins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "version", "description", "install", "integrity", "availability"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "install": {
                "type": "object",
                "required": ["transport", "source"],
                "additionalProperties": false,
                "properties": {
                  "transport": { "const": "local-path" },
                  "source": { "const": "plugins/vida-powers" }
                }
              },
              "integrity": {
                "type": "object",
                "required": ["digest"],
                "additionalProperties": false,
                "properties": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" } }
              },
              "availability": {
                "type": "object",
                "required": ["status"],
                "additionalProperties": false,
                "properties": { "status": { "const": "available" } }
              }
            }
          }
        }
      }
    },
    "antigravityPlugin": {
      "type": "object",
      "required": ["name", "description"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
